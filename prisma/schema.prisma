// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  membership   Membership?
}

model Career {
  id           String        @id @default(cuid())
  inviteCode   String        @unique
  leagueId     String
  league       League        @relation(fields: [leagueId], references: [id])
  season       String
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  games        Game[]
  contracts    Contract[]
  playerStates PlayerState[]
  prospects    Prospect[]
  tradeOffers  TradeOffer[]
}

// Qui gère quelle équipe dans une Career (ligue) partagée. Un compte n'est
// membre que d'une seule ligue à la fois (userId @unique) ; une équipe ne
// peut être prise que par un seul membre (@@unique([careerId, teamId])).
// Une équipe sans Membership est gérée par l'IA.
model Membership {
  id       String   @id @default(cuid())
  careerId String
  career   Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([careerId, teamId])
  @@index([careerId])
}

model League {
  id          String       @id
  code        String       @unique
  name        String
  season      String
  salaryCap   Int
  conferences Conference[]
  teams       Team[]
  careers     Career[]
  games       Game[]
  prospects   Prospect[]
}

model Conference {
  id       String @id
  leagueId String
  league   League @relation(fields: [leagueId], references: [id])
  name     String
  teams    Team[]

  @@index([leagueId])
}

model Team {
  id             String       @id
  leagueId       String
  league         League       @relation(fields: [leagueId], references: [id])
  conferenceId   String
  conference     Conference   @relation(fields: [conferenceId], references: [id])
  city           String
  name           String
  abbreviation   String
  primaryColor   String
  secondaryColor String
  players        Player[]
  memberships    Membership[]
  homeGames      Game[]       @relation("HomeTeam")
  awayGames      Game[]       @relation("AwayTeam")
  contracts      Contract[]

  @@index([leagueId])
  @@index([conferenceId])
}

model Player {
  id            String        @id
  teamId        String
  team          Team          @relation(fields: [teamId], references: [id])
  leagueId      String
  firstName     String
  lastName      String
  position      String
  jerseyNumber  Int
  heightCm      Int
  age           Int
  overallRating Int
  scoring       Int
  playmaking    Int
  rebounding    Int
  defense       Int
  athleticism   Int
  contracts     Contract[]
  playerStates  PlayerState[]

  @@index([teamId])
}

model Game {
  id         String   @id @default(cuid())
  careerId   String
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id])
  season     String
  gameDate   DateTime
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  status     String   @default("scheduled")
  homeScore  Int?
  awayScore  Int?
  boxScore   String?
  homeReady  Boolean  @default(false)
  awayReady  Boolean  @default(false)

  @@index([careerId])
}

model Contract {
  id             String   @id @default(cuid())
  careerId       String
  career         Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id])
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  salary         Int
  yearsRemaining Int
  createdAt      DateTime @default(now())

  @@unique([careerId, playerId])
  @@index([careerId])
  @@index([careerId, teamId])
}

model PlayerState {
  id            String  @id @default(cuid())
  careerId      String
  career        Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player  @relation(fields: [playerId], references: [id])
  age           Int
  overallRating Int
  scoring       Int
  playmaking    Int
  rebounding    Int
  defense       Int
  athleticism   Int
  retired       Boolean @default(false)

  @@unique([careerId, playerId])
  @@index([careerId])
}

model Prospect {
  id            String @id @default(cuid())
  careerId      String
  career        Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  leagueId      String
  league        League @relation(fields: [leagueId], references: [id])
  firstName     String
  lastName      String
  position      String
  heightCm      Int
  age           Int
  overallRating Int
  scoring       Int
  playmaking    Int
  rebounding    Int
  defense       Int
  athleticism   Int

  @@index([careerId])
}

// Proposition d'échange en attente entre deux managers humains. Un adversaire
// géré par l'IA n'en crée jamais : proposeTrade exécute l'échange
// immédiatement dans ce cas (heuristique de tolérance, comportement solo
// inchangé).
model TradeOffer {
  id         String           @id @default(cuid())
  careerId   String
  career     Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  fromTeamId String
  toTeamId   String
  status     String           @default("pending") // pending | accepted | rejected | cancelled
  createdAt  DateTime         @default(now())
  items      TradeOfferItem[]

  @@index([careerId])
  @@index([toTeamId])
}

model TradeOfferItem {
  id           String     @id @default(cuid())
  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  playerId     String
  side         String // "from" | "to"

  @@index([tradeOfferId])
}
