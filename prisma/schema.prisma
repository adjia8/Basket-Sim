// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  membership   Membership?
}

model Career {
  id               String            @id @default(cuid())
  inviteCode       String            @unique
  leagueId         String
  league           League            @relation(fields: [leagueId], references: [id])
  season           String
  createdAt        DateTime          @default(now())
  memberships      Membership[]
  games            Game[]
  contracts        Contract[]
  playerStates     PlayerState[]
  prospects        Prospect[]
  tradeOffers      TradeOffer[]
  draftPicks       DraftPick[]
  deadCap          DeadCap[]
  playoffSeries    PlayoffSeries[]
  teamStates       TeamState[]
  playerTeamStints PlayerTeamStint[]
  pressConferences PressConference[]
}

// Une conférence = 3-4 questions générées ensemble, répondues en un seul
// envoi. Les options de réponse (avec leur ton) sont générées à la création
// et stockées en JSON plutôt que normalisées — même esprit que
// Game.boxScore, pas besoin d'une table à part pour un contenu jamais
// requêté indépendamment de sa question.
model PressConference {
  id        String          @id @default(cuid())
  careerId  String
  career    Career          @relation(fields: [careerId], references: [id], onDelete: Cascade)
  teamId    String // pas de relation formelle à TeamState (identifiée par (careerId, teamId), pas par un id propre) — même pattern que Contract/DeadCap, qui référencent juste teamId en champ simple
  gameDate  DateTime // date du match qui a déclenché la conférence
  status    String          @default("pending") // "pending" | "answered"
  createdAt DateTime        @default(now())
  questions PressQuestion[]

  @@index([careerId, teamId])
}

model PressQuestion {
  id                String          @id @default(cuid())
  pressConferenceId String
  pressConference   PressConference @relation(fields: [pressConferenceId], references: [id], onDelete: Cascade)
  order             Int
  prompt            String
  category          String // "results" | "roster" | "management" | "future"
  optionsJson       String // JSON: { id: string; label: string; tone: AnswerTone }[]
  chosenOptionId    String?
}

// Qui gère quelle équipe dans une Career (ligue) partagée. Un compte n'est
// membre que d'une seule ligue à la fois (userId @unique) ; une équipe ne
// peut être prise que par un seul membre (@@unique([careerId, teamId])).
// Une équipe sans Membership est gérée par l'IA.
model Membership {
  id        String     @id @default(cuid())
  careerId  String
  career    Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team       @relation(fields: [teamId], references: [id])
  joinedAt  DateTime   @default(now())
  gmProfile GmProfile?

  @@unique([careerId, teamId])
  @@index([careerId])
}

// Identité du GM incarné par ce Membership — 1:1, persiste tel quel à
// travers un licenciement/dépeçage puisque Membership n'est jamais supprimée
// ni recréée : seul teamId change (voir reassignFranchise/acceptPoachOffer).
model GmProfile {
  id                     String           @id @default(cuid())
  membershipId           String           @unique
  membership             Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  age                    Int
  sex                    String // "M" | "F" | "autre"
  offensePoints          Int
  defensePoints          Int
  physicalPoints         Int
  tacticalPoints         Int
  chemistryPoints        Int
  hiredSeason            String // saison de prise de poste À L'ÉQUIPE ACTUELLE (reset au changement d'équipe)
  currentExpectationTier String // objectif de la saison en cours
  warningsAtCurrentTeam  Int              @default(0)
  pendingReassignment    Boolean          @default(false) // vient d'être viré, doit choisir une nouvelle franchise
  pendingOfferTeamId     String? // offre de dépeçage en attente de réponse
  frontOfficeApproval    Int              @default(50) // 0-99, piloté par les réponses en conférence de presse
  seasonRecords          GmSeasonRecord[]
}

// Journal historique (bilan de saison + de carrière), jamais modifié après création.
model GmSeasonRecord {
  id              String    @id @default(cuid())
  gmProfileId     String
  gmProfile       GmProfile @relation(fields: [gmProfileId], references: [id], onDelete: Cascade)
  teamId          String
  season          String
  wins            Int
  losses          Int
  expectationTier String
  resultTier      String
  outcome         String // "met" | "exceeded" | "warning" | "fired" | "poached"
  createdAt       DateTime  @default(now())

  @@index([gmProfileId])
}

model League {
  id          String       @id
  code        String       @unique
  name        String
  season      String
  salaryCap   Int
  conferences Conference[]
  teams       Team[]
  careers     Career[]
  games       Game[]
  prospects   Prospect[]
}

model Conference {
  id       String @id
  leagueId String
  league   League @relation(fields: [leagueId], references: [id])
  name     String
  teams    Team[]

  @@index([leagueId])
}

model Team {
  id                 String            @id
  leagueId           String
  league             League            @relation(fields: [leagueId], references: [id])
  conferenceId       String
  conference         Conference        @relation(fields: [conferenceId], references: [id])
  city               String
  name               String
  abbreviation       String
  primaryColor       String
  secondaryColor     String
  marketAppeal       Int               @default(50) // 0-99, attractivité de la ville (marché, climat, style de vie)
  players            Player[]
  memberships        Membership[]
  homeGames          Game[]            @relation("HomeTeam")
  awayGames          Game[]            @relation("AwayTeam")
  contracts          Contract[]
  draftPicks         DraftPick[]       @relation("DraftPickCurrentTeam")
  originalDraftPicks DraftPick[]       @relation("DraftPickOriginalTeam")
  deadCap            DeadCap[]
  homePlayoffSeries  PlayoffSeries[]   @relation("PlayoffSeriesHomeTeam")
  awayPlayoffSeries  PlayoffSeries[]   @relation("PlayoffSeriesAwayTeam")
  teamStates         TeamState[]
  playerTeamStints   PlayerTeamStint[]

  @@index([leagueId])
  @@index([conferenceId])
}

model Player {
  id             String            @id
  teamId         String
  team           Team              @relation(fields: [teamId], references: [id])
  leagueId       String
  firstName      String
  lastName       String
  position       String
  jerseyNumber   Int
  heightCm       Int
  age            Int
  overallRating  Int
  // 10 attributs techniques (0-99) — pilotent la simulation (voir mockEngine.ts) ;
  // distincts d'overallRating, qui reste la valeur "front-office" (salaire, trade, draft).
  scoringInside  Int
  scoringOutside Int
  playmaking     Int
  defenseInside  Int
  defenseOutside Int
  rebounding     Int
  athleticism    Int
  basketballIQ   Int
  clutch         Int
  stamina        Int
  injuryRisk     Int               @default(30) // 0-99, risque de blessure basé sur l'historique réel connu
  nationality    String            @default("États-Unis")
  contracts      Contract[]
  playerStates   PlayerState[]
  teamStints     PlayerTeamStint[]

  @@index([teamId])
}

model Game {
  id         String   @id @default(cuid())
  careerId   String
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id])
  season     String
  gameDate   DateTime
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  status     String   @default("scheduled")
  homeScore  Int?
  awayScore  Int?
  boxScore   String?
  homeReady  Boolean  @default(false)
  awayReady  Boolean  @default(false)

  playoffSeriesId String?
  playoffSeries   PlayoffSeries? @relation(fields: [playoffSeriesId], references: [id], onDelete: SetNull)
  gameNumber      Int? // position dans la série (1er match, 2e, ...) — détermine qui reçoit

  @@index([careerId])
  @@index([playoffSeriesId])
}

// Une série de playoffs (ou un match unique de play-in, bestOf = 1). Rejoue
// exactement comme un match de saison régulière (même Game, mêmes homeReady/
// awayReady) : seul l'agrégat homeWins/awayWins et la clôture de la série
// diffèrent. season porte le suffixe "-playoffs" pour rester hors du champ
// des requêtes de saison régulière (classement, calendrier, date limite des
// échanges) sans aucune modification de ces requêtes.
model PlayoffSeries {
  id           String  @id @default(cuid())
  careerId     String
  career       Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  season       String
  conference   String? // null pour la WNBA (pas de logique de conférence) et la finale NBA
  round        String // "play-in-7-8" | "play-in-9-10" | "play-in-final" | "round-1" | "conf-semis" | "conf-finals" | "finals" (NBA)
  // "round-1" | "semifinals" | "finals" (WNBA)
  // Position dans le bracket de ce tour (0-indexé) : le tour suivant apparie
  // slotIndex i avec le dernier slotIndex (n-1-i), pas de reseeding dynamique
  // sur le seed — nécessaire pour retrouver l'ordre du bracket sur plusieurs
  // tours (le seed du vainqueur d'une série ne dit pas à lui seul sa position
  // dans l'arbre).
  slotIndex    Int     @default(0)
  bestOf       Int
  homeSeed     Int
  homeTeamId   String
  homeTeam     Team    @relation("PlayoffSeriesHomeTeam", fields: [homeTeamId], references: [id])
  awaySeed     Int
  awayTeamId   String
  awayTeam     Team    @relation("PlayoffSeriesAwayTeam", fields: [awayTeamId], references: [id])
  homeWins     Int     @default(0)
  awayWins     Int     @default(0)
  winnerTeamId String?
  games        Game[]

  @@index([careerId, season])
}

model Contract {
  id             String   @id @default(cuid())
  careerId       String
  career         Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id])
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  salary         Int
  yearsRemaining Int
  guaranteed     Boolean  @default(true)
  contractType   String   @default("standard") // "standard" | "two_way" | "development" — voir contract-type-rules.ts
  createdAt      DateTime @default(now())

  @@unique([careerId, playerId])
  @@index([careerId])
  @@index([careerId, teamId])
}

// Historique des équipes traversées par un joueur au sein d'une Career —
// alimenté à partir de la mise en place de cette table (repêchage/signature/
// trade) uniquement : impossible de reconstruire le passé d'une Career déjà
// en cours (Contract.teamId est écrasé sur trade, supprimé sur coupure, sans
// aucune trace).
model PlayerTeamStint {
  id        String   @id @default(cuid())
  careerId  String
  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  season    String
  reason    String // "drafted" | "signed" | "traded"
  createdAt DateTime @default(now())

  @@index([careerId, playerId])
}

model PlayerState {
  id                   String  @id @default(cuid())
  careerId             String
  career               Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  playerId             String
  player               Player  @relation(fields: [playerId], references: [id])
  age                  Int
  overallRating        Int
  scoringInside        Int
  scoringOutside       Int
  playmaking           Int
  defenseInside        Int
  defenseOutside       Int
  rebounding           Int
  athleticism          Int
  basketballIQ         Int
  clutch               Int
  stamina              Int
  retired              Boolean @default(false)
  injured              Boolean @default(false)
  injuryGamesRemaining Int     @default(0)
  renown               Int     @default(50) // 0-99, évolue à chaque match joué
  fatigue              Int     @default(0) // 0-99, monte après un match, redescend avec le repos
  conditioning         Int     @default(100) // 0-100, 100 = conditionnement optimal
  injurySeverity       String? // "minor" | "moderate" | "severe", null si sain
  playingThroughInjury Boolean @default(false) // choix du manager, valable seulement pour une blessure "minor"
  peakOverallRating    Int     @default(0) // plus haut overallRating jamais atteint en carrière
  peakRenown           Int     @default(50) // plus haut renommé jamais atteint en carrière
  hallOfFame           Boolean @default(false) // fixé à la retraite si les seuils HOF sont atteints
  retiredSeason        String? // saison (label) de la retraite, null si actif
  trainingBoost        Int     @default(0) // 0-8, bonus temporaire courant sur les attributs de trainingBoostFocus
  trainingBoostFocus   String? // catégorie ciblée par le bonus courant, null si aucun

  @@unique([careerId, playerId])
  @@index([careerId])
}

model Prospect {
  id             String  @id @default(cuid())
  careerId       String
  career         Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  leagueId       String
  league         League  @relation(fields: [leagueId], references: [id])
  firstName      String
  lastName       String
  position       String
  heightCm       Int
  age            Int
  overallRating  Int
  scoringInside  Int
  scoringOutside Int
  playmaking     Int
  defenseInside  Int
  defenseOutside Int
  rebounding     Int
  athleticism    Int
  basketballIQ   Int
  clutch         Int
  stamina        Int
  scoutingNote   String? // ex. "Duke (NCAA)", "Real Madrid (Espagne)" — null pour un prospect généré
  nationality    String  @default("États-Unis")

  @@index([careerId])
}

// Proposition d'échange en attente entre deux managers humains. Un adversaire
// géré par l'IA n'en crée jamais : proposeTrade exécute l'échange
// immédiatement dans ce cas (heuristique de tolérance, comportement solo
// inchangé).
model TradeOffer {
  id         String           @id @default(cuid())
  careerId   String
  career     Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  fromTeamId String
  toTeamId   String
  status     String           @default("pending") // pending | accepted | rejected | cancelled
  createdAt  DateTime         @default(now())
  items      TradeOfferItem[]

  @@index([careerId])
  @@index([toTeamId])
}

// playerId/draftPickId : exactement l'un des deux est renseigné selon la
// nature de l'actif échangé. Pas de relation Prisma vers Player/DraftPick
// (même convention que playerId ailleurs dans le schéma) — résolu
// manuellement côté appelant via une requête séparée.
model TradeOfferItem {
  id           String     @id @default(cuid())
  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  playerId     String?
  draftPickId  String?
  side         String // "from" | "to"

  @@index([tradeOfferId])
}

// Un pick de draft, résolu (saison en cours, pickNumber connu) ou futur
// (pickNumber null tant que la saison correspondante n'a pas été jouée).
// originalTeamId (fixe) détermine la position du pick une fois résolu, via
// le classement de cette équipe ; teamId (mutable par échange) est qui a
// actuellement le droit de le faire. "skipped" = l'équipe au pick ne
// pouvait pas légalement drafter (effectif complet ou plafond dépassé).
model DraftPick {
  id              String  @id @default(cuid())
  careerId        String
  career          Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  season          String
  round           Int
  pickNumber      Int?
  originalTeamId  String
  originalTeam    Team    @relation("DraftPickOriginalTeam", fields: [originalTeamId], references: [id])
  teamId          String
  team            Team    @relation("DraftPickCurrentTeam", fields: [teamId], references: [id])
  status          String  @default("pending") // pending | completed | skipped
  draftedPlayerId String?

  @@unique([careerId, season, round, originalTeamId])
  @@index([careerId, season, status])
}

// Argent mort : reste d'un contrat garanti coupé avant terme, qui continue de
// compter dans la masse salariale de l'équipe jusqu'à expiration. Un joueur
// libéré redevient un vrai agent libre signable ailleurs (donc distinct de
// Contract, protégé par @@unique([careerId, playerId]) — les deux doivent
// pouvoir coexister pour le même joueur).
model DeadCap {
  id             String @id @default(cuid())
  careerId       String
  career         Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team   @relation(fields: [teamId], references: [id])
  playerId       String
  salary         Int
  yearsRemaining Int

  @@index([careerId, teamId])
}

// Chimie d'équipe par Career — dérive lentement vers une cible calculée à
// chaque match (bilan + QI basket moyen du roster, voir chemistry-rules.ts).
// Créée paresseusement à la première lecture (défaut 50), même principe que
// getCurrentDraftPick.
model TeamState {
  id                      String    @id @default(cuid())
  careerId                String
  career                  Career    @relation(fields: [careerId], references: [id], onDelete: Cascade)
  teamId                  String
  team                    Team      @relation(fields: [teamId], references: [id])
  chemistry               Int       @default(50) // 0-99
  finances                Int       @default(0) // dollars, trésorerie de franchise — distincte du plafond salarial
  facilitiesLevel         Int       @default(50) // 0-100
  trainingStaffLevel      Int       @default(50) // 0-100
  trainingFocus           String? // "offensive" | "defensive" | "tactical" | "physical" | "chemistry" | "rest", null = aucun
  trainingIntensity       String    @default("medium") // "low" | "medium" | "high"
  morale                  Int       @default(50) // 0-99, piloté par les réponses en conférence de presse
  publicOpinion           Int       @default(50) // 0-99, opinion fans/autres franchises, pilotée par les réponses en conférence de presse
  lastPressConferenceDate DateTime?

  @@unique([careerId, teamId])
}
