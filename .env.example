# Postgres (Neon) — connexion "pooled" (via PgBouncer), utilisée à l'exécution.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Postgres (Neon) — connexion directe, utilisée uniquement pour les migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de signature des sessions (cookie JWT). Générer avec:
#   openssl rand -base64 32
SESSION_SECRET="change-me"
